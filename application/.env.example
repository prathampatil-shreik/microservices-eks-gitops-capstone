# MicroTask — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git. It is listed in .gitignore.

# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=microtask_db
MYSQL_USER=microtask_user
MYSQL_PASSWORD=microtask_pass

# ── API ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false

# ── Worker ─────────────────────────────────────────────────────────────────────
WORKER_NAME=worker-1
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
MIN_PROCESSING_SECONDS=2
MAX_PROCESSING_SECONDS=8

# Set FAILURE_RATE=0.5 to make 50% of tasks fail — useful for testing alerts
FAILURE_RATE=0.1
MAX_RETRIES=3
